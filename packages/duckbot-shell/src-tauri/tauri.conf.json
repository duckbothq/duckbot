{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duckbot",
  "version": "0.1.0",
  "identifier": "net.igears.duckbot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Duckbot",
        "width": 900,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
